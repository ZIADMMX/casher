# ========================================================
# Kashiear / FOX.CLOUD Central Engine - Environment Template
# Copy this file to .env and configure with secure credentials
# ========================================================

# PostgreSQL Primary (Master - Write Operations)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=kashiear_pos
PGPASSWORD=your_secure_db_password_here
PGPORT=5432

# PostgreSQL Replica (Slave - Heavy Read & Analytics Operations)
PG_REPLICA_HOST=localhost
PG_REPLICA_PORT=5432

# Server Port & Secrets
PORT=5000
# Generate a strong 64-byte random secret:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_generated_cryptographically_secure_jwt_secret_here
NODE_ENV=development
# Central nodes listen on localhost behind load-balancer.js; override only to expose a node directly.
CENTRAL_BIND_HOST=127.0.0.1
# Central JWT lifetime (desktop clients refresh it automatically).
CENTRAL_TOKEN_TTL=8h
# Additional LAN certificate names or IPv4 addresses, comma-separated.
KASHIEAR_TLS_HOSTS=
# Additional trusted browser origins, comma-separated. Do not use "*".
CORS_ALLOWED_ORIGINS=
89
# Public HTTPS endpoint returning {"utc":"<ISO-8601 UTC timestamp>"}.
FOX_LICENSE_TIME_URL=
