{
  "name": "foxcloud",
  "version": "1.0.1",
  "description": "نظام الكاشير الذكي لمحلات الملابس",
  "main": "electron-entry.js",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src electron routes scripts *.js",
    "lint:fix": "eslint src electron routes scripts *.js --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"electron/**/*.js\"",
    "prebuild": "npm run lint && npm run build:main",
    "build:main": "node scripts/obfuscate-electron.js",
    "verify:license-time": "node scripts/verify-license-time.js",
    "build": "vite build",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest --runInBand --cacheDirectory=\"./.jest-cache\"",
    "test:frontend": "vitest run",
    "test:watch": "jest --watch",
    "test:frontend:watch": "vitest",
    "test:e2e": "playwright test e2e",
    "start": "npm run build && electron .",
    "api": "tsx api-server.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run verify:license-time && npm run build && npm run rebuild && electron-builder --win --x64",
    "package:win": "npm run verify:license-time && npm run build && npm run rebuild && electron-builder --win --x64 --publish never",
    "package:dir": "npm run verify:license-time && npm run build && npm run rebuild && electron-builder --win --x64 --dir",
    "package:linux": "npm run verify:license-time && npm run build && npm run rebuild && electron-builder --linux --x64 --publish never",
    "package:mac": "npm run verify:license-time && npm run build && npm run rebuild && electron-builder --mac --publish never"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/e2e/",
      "<rootDir>/tests/frontend/"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.foxcloud.pos",
    "productName": "foxcloud POS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron-entry.js",
      "electron-obfuscated/**/*",
      "license-time.config.json",
      "shared/**/*",
      "public/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "foxcloud POS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "npmRebuild": false,
    "nodeGypRebuild": false
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.1.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "javascript-obfuscator": "^4.1.1",
    "jest": "^30.5.1",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.3",
    "vite": "^8.2.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@reduxjs/toolkit": "^2.6.0",
    "@tanstack/react-query": "^5.67.1",
    "@tanstack/react-query-devtools": "^5.67.1",
    "@workspace/boosthis-runtime-node": "file:./lib/boosthis-runtime-node",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "boosthis-checklist": "file:./lib/boosthis-checklist",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.2.0",
    "three": "^0.186.1"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
